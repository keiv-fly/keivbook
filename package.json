{
  "name": "keivbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ui": "playwright test",
    "format": "prettier --write src tests *.json *.ts scripts && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "package": "tauri build --no-bundle && node scripts/package.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/theme-one-dark": "^6.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/markdown": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "codemirror": "^6.0.0",
    "dompurify": "^3.0.0",
    "hash-wasm": "^4.12.0",
    "lucide": "^0.468.0",
    "markdown-it": "^14.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/markdown-it": "^14.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.10.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.12"
  }
}
